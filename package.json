{
  "name": "cc-sandbox-gpu-mac",
  "version": "0.1.0",
  "description": "Run GPU (Metal/MPS) workloads from Claude Code's sandboxed Bash tool on macOS",
  "type": "module",
  "private": true,
  "os": ["darwin"],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/**/*.test.ts'",
    "install-local": "npm run build && node scripts/install.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.282",
    "@anthropic-ai/sandbox-runtime": "0.0.77"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
